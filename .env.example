# ─── Anthropic ───────────────────────────────────────────────────────────────
# Claude API key — get it at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Secret key for server-side Stripe calls (test: sk_test_..., live: sk_live_...)
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — from Stripe dashboard > Webhooks > your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for each plan — from Stripe dashboard > Products
STRIPE_PRICE_ESENCIAL=price_...
STRIPE_PRICE_COMPLETO=price_...

# ─── Resend ──────────────────────────────────────────────────────────────────
# API key for transactional email via Resend
RESEND_API_KEY=re_...

# From address used when sending reports (must be verified in Resend)
REPORT_EMAIL_FROM=reports@imconsulting.com

# ─── Internal ────────────────────────────────────────────────────────────────
# Isaac's email for internal notifications and copies
ISAAC_EMAIL=its.isaacmoreno@gmail.com
